{"nodes": [{"id": "docs_measurement_validation_measurement_validation_before_accuracy_claims", "label": "Measurement validation before accuracy claims", "file_type": "document", "source_file": "docs/measurement_validation.md", "source_location": "docs/measurement_validation.md:1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_measurement_validation_intended_operating_envelope", "label": "Intended operating envelope", "file_type": "rationale", "source_file": "docs/measurement_validation.md", "source_location": "docs/measurement_validation.md:5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Specify strip brand and lot, valid pH interval, sample types, timing, reference paper, lighting, and phones; do not infer reference pH from household substance labels."}, {"id": "docs_measurement_validation_paired_reference_measurements", "label": "Paired reference measurements", "file_type": "rationale", "source_file": "docs/measurement_validation.md", "source_location": "docs/measurement_validation.md:7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Collect paired strip photographs and independent reference measurements, preserving raw images, snapshots, ROIs, versions, device, lot, lighting, timing, and reference provenance."}, {"id": "docs_measurement_validation_negative_and_adverse_captures", "label": "Negative and adverse captures", "file_type": "rationale", "source_file": "docs/measurement_validation.md", "source_location": "docs/measurement_validation.md:7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Include repeats, blank or non-strip negatives, glare, shadows, motion blur, and out-of-range samples."}, {"id": "docs_measurement_validation_independent_validation_split", "label": "Independent validation split", "file_type": "rationale", "source_file": "docs/measurement_validation.md", "source_location": "docs/measurement_validation.md:9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separate calibration/training and validation images by phone, lot, and session to avoid near-duplicate leakage; test the complete workflow."}, {"id": "docs_measurement_validation_measurement_acceptance_metrics", "label": "Measurement acceptance metrics", "file_type": "rationale", "source_file": "docs/measurement_validation.md", "source_location": "docs/measurement_validation.md:11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Specify acceptable error, bias, repeatability, and rejection rates before evaluation; report counts, MAE, signed bias, high-percentile absolute error, repeatability, accepted/rejected counts and subgroup results."}, {"id": "docs_measurement_validation_holdout_threshold_evaluation", "label": "Holdout threshold evaluation", "file_type": "rationale", "source_file": "docs/measurement_validation.md", "source_location": "docs/measurement_validation.md:13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tune rejection thresholds only on development data, then evaluate untouched holdout data."}, {"id": "docs_measurement_validation_empirical_uncertainty_calibration", "label": "Empirical uncertainty calibration", "file_type": "rationale", "source_file": "docs/measurement_validation.md", "source_location": "docs/measurement_validation.md:13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Calibrate uncertainty empirically; never transform raw color distance into percentage confidence without evidence."}, {"id": "docs_measurement_validation_owner_validation_release_gate", "label": "Owner validation release gate", "file_type": "rationale", "source_file": "docs/measurement_validation.md", "source_location": "docs/measurement_validation.md:15", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Owner approves written validation report and operating envelope; retain unvalidated labeling and avoid accuracy or suitability claims until then. No reference dataset or independently measured results were supplied."}], "edges": [{"source": "docs_measurement_validation_measurement_validation_before_accuracy_claims", "target": "docs_measurement_validation_intended_operating_envelope", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/measurement_validation.md", "source_location": "docs/measurement_validation.md:5", "weight": 1.0}, {"source": "docs_measurement_validation_measurement_validation_before_accuracy_claims", "target": "docs_measurement_validation_paired_reference_measurements", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/measurement_validation.md", "source_location": "docs/measurement_validation.md:7", "weight": 1.0}, {"source": "docs_measurement_validation_measurement_validation_before_accuracy_claims", "target": "docs_measurement_validation_negative_and_adverse_captures", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/measurement_validation.md", "source_location": "docs/measurement_validation.md:7", "weight": 1.0}, {"source": "docs_measurement_validation_measurement_validation_before_accuracy_claims", "target": "docs_measurement_validation_independent_validation_split", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/measurement_validation.md", "source_location": "docs/measurement_validation.md:9", "weight": 1.0}, {"source": "docs_measurement_validation_measurement_validation_before_accuracy_claims", "target": "docs_measurement_validation_measurement_acceptance_metrics", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/measurement_validation.md", "sourc