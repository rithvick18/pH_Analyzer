{"nodes": [{"id": "docs_release_release_configuration_and_checks", "label": "Release configuration and checks", "file_type": "document", "source_file": "docs/release.md", "source_location": "docs/release.md:1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_release_android_production_application_id", "label": "Android production application ID", "file_type": "rationale", "source_file": "docs/release.md", "source_location": "docs/release.md:5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Owner supplies registered PH_APPLICATION_ID; debug namespace remains unchanged."}, {"id": "docs_release_android_release_signing", "label": "Android release signing", "file_type": "rationale", "source_file": "docs/release.md", "source_location": "docs/release.md:12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Provide local ignored android/key.properties or protected CI secrets; no signing material is included."}, {"id": "docs_release_unsigned_compilation_validation", "label": "Unsigned compilation validation", "file_type": "rationale", "source_file": "docs/release.md", "source_location": "docs/release.md:14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Normal release fails for missing/example application ID or incomplete signing; PH_UNSIGNED_VALIDATION=true is compile-only and artifacts must not be distributed."}, {"id": "docs_release_ios_production_identity", "label": "iOS production identity", "file_type": "rationale", "source_file": "docs/release.md", "source_location": "docs/release.md:18", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Owner must select registered production bundle ID and signing profile; existing development identity remains, while CI compiles without codesigning."}, {"id": "docs_release_device_lifecycle_acceptance", "label": "Device lifecycle acceptance", "file_type": "rationale", "source_file": "docs/release.md", "source_location": "docs/release.md:23", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Test permissions, background/resume, rotation, initialization navigation, gallery cancellation, save/reopen/share, offline behavior, and interrupted Android picking on real Android and iOS devices."}, {"id": "docs_release_pixel_geometry_acceptance", "label": "Pixel geometry acceptance", "file_type": "rationale", "source_file": "docs/release.md", "source_location": "docs/release.md:24", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Confirm ROIs, thumbnails, overlays, and PDF annotations agree across portrait, landscape, and EXIF-rotated photos."}, {"id": "docs_release_result_labeling_acceptance", "label": "Result labeling acceptance", "file_type": "rationale", "source_file": "docs/release.md", "source_location": "docs/release.md:25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Camera failure cannot create a demo implicitly; demo, unvalidated, and legacy labels persist in storage and sharing."}, {"id": "docs_release_storage_failure_acceptance", "label": "Storage failure acceptance", "file_type": "rationale", "source_file": "docs/release.md", "source_location": "docs/release.md:26", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Test corruption, missing data, exhaustion, interruptions, older records, orphan cleanup and deletion; do not erase history to hide failures."}, {"id": "docs_release_accessibility_acceptance", "label": "Accessibility acceptance", "file_type": "rationale", "source_file": "docs/release.md", "source_location": "docs/release.md:27", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Test large text, screen readers, move/resize controls, small phones, reduced