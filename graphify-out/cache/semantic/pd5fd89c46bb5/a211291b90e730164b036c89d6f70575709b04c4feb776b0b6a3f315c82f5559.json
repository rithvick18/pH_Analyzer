{"nodes": [{"id": "readme_ph_analyzer", "label": "pH Analyzer", "file_type": "document", "source_file": "README.md", "source_location": "README.md:1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_offline_edge_computing", "label": "Offline edge computing", "file_type": "rationale", "source_file": "README.md", "source_location": "README.md:14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No API key, account, .env asset, cloud strip recognition, or network call is needed."}, {"id": "readme_experimental_ph_estimates", "label": "Experimental pH estimates", "file_type": "rationale", "source_file": "README.md", "source_location": "README.md:3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Results, history, and reports identify readings as unvalidated estimates; the app is not an independently validated instrument."}, {"id": "readme_android_and_ios_release_targets", "label": "Android and iOS release targets", "file_type": "rationale", "source_file": "README.md", "source_location": "README.md:5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Other platform folders are development scaffolding."}, {"id": "readme_still_image_capture", "label": "Still image capture", "file_type": "rationale", "source_file": "README.md", "source_location": "README.md:9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Camera permission failures show an error and never substitute a demo photo."}, {"id": "readme_region_of_interest_extraction", "label": "Region of interest extraction", "file_type": "rationale", "source_file": "README.md", "source_location": "README.md:10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drawing and accessible move/resize controls select the same normalized still-image pixels."}, {"id": "readme_optional_reference_background", "label": "Optional reference background", "file_type": "rationale", "source_file": "README.md", "source_location": "README.md:10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Disabling reference paper produces an explicit fixed-background warning."}, {"id": "readme_cielab_spline_matching", "label": "CIELAB spline matching", "file_type": "rationale", "source_file": "README.md", "source_location": "README.md:11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On-device acquisition checks reject colors too far from calibration and flag ambiguous or boundary matches."}, {"id": "readme_measurement_provenance", "label": "Measurement provenance", "file_type": "rationale", "source_file": "README.md", "source_location": "README.md:12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each new saved record retains calibration hash, algorithm version, colors, warnings, source, and measurement time."}, {"id": "readme_explicit_demo_mode", "label": "Explicit demo mode", "file_type": "rationale", "source_file": "README.md", "source_location": "README.md:16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bundled reference photographs are used only through explicit demo selection; results remain labeled."}, {"id": "readme_calibration_anchors", "label": "Calibration anchors", "file_type": "rationale", "source_file": "README.md", "source_location": "README.md:20", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eight experimental anchors define the supported domain; candidate search stays within that domain."}, {"id": "readme_numerical_ph_resolution", "label": "Numerical pH resolution", "file_type": "rationale", "source_file": "README.md", "source_location": "README.md:20", "source_url": null, "captured_at": null, "author": null, 